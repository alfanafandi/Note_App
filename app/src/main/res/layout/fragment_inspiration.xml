<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF5EF">

    <!-- TAMPILAN AWAL SAAT KOSONG -->
    <LinearLayout
        android:id="@+id/llInitialState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_menu_edit"
            app:tint="#A1887F"
            android:contentDescription="Icon buat rencana baru"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Rencanakan Sesi Belajarmu"
            android:textColor="#3E2723"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Beri tahu AI topik yang ingin kamu pelajari,\ndan biarkan ia membuatkan rencana untukmu."
            android:textColor="#6D4C41"
            android:textSize="16sp" />
        <Button
            android:id="@+id/btnMainAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#6D4C41"
            android:paddingLeft="32dp"
            android:paddingTop="12dp"
            android:paddingRight="32dp"
            android:paddingBottom="12dp"
            android:text="✨ Buat Rencana Belajar"
            android:textColor="#FFFFFF" />
    </LinearLayout>


    <!-- TAMPILAN SAAT ADA RENCANA BELAJAR -->
    <LinearLayout
        android:id="@+id/planContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="gone">

        <!-- HEADER (JUDUL & TOMBOL-TOMBOL AKSI) -->
        <RelativeLayout
            android:id="@+id/headerPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvPlanTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/btnSwitchPlan"
                android:layout_marginEnd="8dp"
                tools:text="Rencana Belajar: Sejarah HTML dari Awal Sampai Akhir"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 🔥🔥 TOMBOL RIWAYAT BARU DITAMBAHKAN DI SINI 🔥🔥 -->
            <ImageButton
                android:id="@+id/btnSwitchPlan"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_toStartOf="@id/btnDeletePlan"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_history"
                app:tint="#6D4C41"
                android:contentDescription="Lihat Riwayat Rencana" />

            <ImageButton
                android:id="@+id/btnDeletePlan"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_menu_delete"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#6D4C41"
                android:contentDescription="Hapus Rencana Belajar" />
        </RelativeLayout>

        <!-- KONTEN YANG BISA DI-SCROLL -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="80dp"
            android:clipToPadding="false">

            <!-- Di sinilah kita akan menambahkan item-item secara dinamis -->
            <LinearLayout
                android:id="@+id/contentPlanContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="8dp"/>
        </ScrollView>

    </LinearLayout>

</LinearLayout>
