<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gradien coklat menyerupai kayu -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#A1887F"
                android:endColor="#D7CCC8"
                android:angle="45"/>
        </shape>
    </item>

    <!-- Opsional: overlay semi-transparent untuk membuat teks lebih jelas -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#55FFFFFF"/> <!-- putih semi-transparent -->
        </shape>
    </item>

</layer-list>
